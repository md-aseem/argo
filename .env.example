# Argo's settings, for running it locally and for deploying it.
#
#   cp .env.example .env      # .env is git-ignored; fill in the blanks below
#
# Running locally only needs the first section. The production scripts use all of it:
#   scripts/deploy.sh         # roll out the version in k8s/kustomization.yaml
#   scripts/setup.sh          # Google Cloud setup (safe to re-run)
# How production fits together: docs/production.md.
#
# Write values without quotes: `docker run --env-file .env` keeps quotes literally.

# ── The app (needed locally and in the cluster) ─────────────────────────────
# Use Vertex AI (Gemini through your Google Cloud project).
GOOGLE_GENAI_USE_ENTERPRISE=1
# The project that holds everything (Vertex AI, bucket, cluster, database).
GOOGLE_CLOUD_PROJECT=
# Where Vertex AI runs. "global" is right unless you need data residency.
GOOGLE_CLOUD_LOCATION=global
# GCS bucket for files Argo saves and uploads. setup.sh creates it if missing.
GOOGLE_CLOUD_BUCKET=
# Where conversations are stored. Leave unset locally to use a SQLite file
# (src/.adk/argo.db). In the cluster it's set for you, pointing at Cloud SQL.
# DATABASE_URL=

# ── Deploying: Google Cloud ─────────────────────────────────────────────────
# One region for the cluster, the database and the image registry. Keep them
# together: the app talks to the database on every request.
REGION=us-east4

# ── Deploying: database (Cloud SQL for PostgreSQL) ──────────────────────────
# The Cloud SQL instance. Created if it doesn't exist (smallest tier, ~$10/month).
DB_INSTANCE=argo-db
# The database inside that instance where conversations are stored. Created if missing.
DB_NAME=argo

# ── Deploying: website ──────────────────────────────────────────────────────
# Argo is served at https://<DOMAIN>/argo/. You point this domain's DNS at the
# load balancer's IP (setup.sh prints it at the end).
DOMAIN=muhammadaseem.com

# ── Deploying: who can sign in (Google login via IAP) ───────────────────────
# Comma-separated. Everyone listed shares the same conversations, and their
# chats run on your Vertex AI bill, so keep this short.
#   user:someone@gmail.com   one Google account
#   group:team@example.com   a Google Group
IAP_MEMBERS=user:you@gmail.com
# The OAuth client the login screen uses (created by hand in the console under
# APIs & Services > Credentials). setup.sh stores it in the cluster.
IAP_CLIENT_ID=
IAP_CLIENT_SECRET=

# ── Deploying: GitHub (builds images when you push a version tag) ───────────
# owner/repo. setup.sh lets this repo push images, and sets the repository
# variables the workflow needs if the gh CLI is logged in.
GITHUB_REPO=md-aseem/argo
